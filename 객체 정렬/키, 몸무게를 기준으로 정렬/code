n = int(input())
name = []
height = []
weight = []
for _ in range(n):
    n_i, h_i, w_i = input().split()
    name.append(n_i)
    height.append(int(h_i))
    weight.append(int(w_i))

# Please write your code here.
class sa:
    def __init__(self,name,height,weight):
        self.n=name
        self.h = height
        self.w =weight
people=[]
for i in range(n):
    person=sa(name[i],height[i],weight[i])
    people.append(person)

people.sort(key=lambda x: (x.h, -x.w))

for i in people:
    print(i.n,i.h,i.w)
