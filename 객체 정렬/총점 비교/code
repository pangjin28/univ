n = int(input())

name = []
score1 = []
score2 = []
score3 = []

for _ in range(n):
    student_input = input().split()
    name.append(student_input[0])
    score1.append(int(student_input[1]))
    score2.append(int(student_input[2]))
    score3.append(int(student_input[3]))

# Please write your code here.
class sa:
    def __init__(self, name, score1,score2,score3):
        self.n = name
        self.a = score1
        self.b = score2
        self.c = score3
people=[]
for i in range(n):
    person = sa(name[i],score1[i],score2[i],score3[i])
    people.append(person)

people.sort(key=lambda x:x.a + x.b + x.c)

for i in people:
    print(i.n, i.a, i.b, i.c)
