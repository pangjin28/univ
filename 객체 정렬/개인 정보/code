n = 5
name = []
height = []
weight = []

for _ in range(n):
    n, h, w = input().split()
    name.append(n)
    height.append(int(h))
    weight.append(float(w))

# Please write your code here.
class sa:
    def __init__(self, name, height, weight):
        self.n = name
        self.h = height
        self.w = weight
people=[]
people2=[]
for i in range(5):
    person = sa(name[i],height[i],weight[i])
    people.append(person)
    people2.append(person)

people.sort(key = lambda x : x.n)
people2.sort(key = lambda x : -x.h)

print("name")
