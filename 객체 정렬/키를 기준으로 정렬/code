n = int(input())
name = []
height = []
weight = []

for _ in range(n):
    n_i, h_i, w_i = input().split()
    name.append(n_i)
    height.append(int(h_i))
    weight.append(int(w_i))

# Please write your code here.
class sa:
    def __init__(self, n_i, h_i, w_i):
        self.n = n_i
        self.h = h_i
        self.w = w_i

people = []
for i in range(n):
    person = sa(name[i], height[i],weight[i])
    people.append(person)

people.sort(key=lambda person : person.h)
for i in people:
    print(i.n,i.h,i.w)
