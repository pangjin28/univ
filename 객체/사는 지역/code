n = int(input())
name = []
street_address = []
region = []

for _ in range(n):
    n_i, s_i, r_i = input().split()
    name.append(n_i)
    street_address.append(s_i)
    region.append(r_i)

# Please write your code here.
class sa:
    def __init__(self, n_i,s_i,r_i):
        self.na = n_i
        self.ad = s_i
        self.re = r_i

people = []

for i in range(n):
    person = sa(name[i],street_address[i],region[i])
    people.append(person)

people.sort(key=lambda person: person.na)

print("name", people[-1].na)
print("addr", people[-1].ad)
print("city", people[-1].re)
