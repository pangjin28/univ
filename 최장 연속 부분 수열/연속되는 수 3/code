n = int(input())
arr = [int(input()) for _ in range(n)]

# Please write your code here.
max_len = 1  
current_len = 1 

for i in range(1, n):
    if arr[i] * arr[i-1] > 0:  
        current_len += 1  
    else: 
        max_len = max(max_len, current_len)  
        current_len = 1 

max_len = max(max_len, current_len)
print(max_len)
