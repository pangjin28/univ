N = int(input())  
grid = [[0] * 201 for _ in range(201)]  

for i in range(N):
    x1, y1, x2, y2 = map(int, input().split())
    color = 1 if i % 2 == 0 else 2   
    for x in range(x1 + 100, x2 + 100):
        for y in range(y1 + 100, y2 + 100):
            grid[x][y] = color  

total_area = 0
for i in range(201):
    for j in range(201):
        if grid[i][j] == 2: 
            total_area += 1

print(total_area)
